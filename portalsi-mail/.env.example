# API Portal SI (SSO + endpoint mail). Pakai loopback di produksi bila mau.
PORTALSI_API_URL=https://api.portalsi.com/api
PORTALSI_API_TIMEOUT_MS=12000

# Server mail lokal (untuk webmail IMAP/SMTP — Tahap 6)
MAIL_IMAP_HOST=127.0.0.1
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=587
MAIL_DOMAIN=portalsi.com

# Port service (adapter-node)
PORT=3200
