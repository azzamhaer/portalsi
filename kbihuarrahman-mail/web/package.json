{
  "name": "kbihuarrahman-mail-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:local": "wrangler d1 execute kbihu_mail --local --file=../schema.sql",
    "db:remote": "wrangler d1 execute kbihu_mail --remote --file=../schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250507.0",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.23.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "^4.20250507.0"
  }
}
