# API Sekolah Impian Mail (auth + gate + mailbox). Backend Laravel TERPISAH.
PORTALSI_API_URL=https://mailapi.sekolahimpian.com/api
PORTALSI_API_TIMEOUT_MS=12000

# Server mail lokal (IMAP/SMTP) — sama VPS, akun di bawah domain sekolahimpian.com
MAIL_IMAP_HOST=127.0.0.1
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=587
MAIL_DOMAIN=sekolahimpian.com

# Service (adapter-node) — port beda dari portalsi-mail (3300, sudah dipakai)
PORT=3301
ORIGIN=https://mail.sekolahimpian.com
BODY_SIZE_LIMIT=36214400
